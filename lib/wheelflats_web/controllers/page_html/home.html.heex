<Layouts.flash_group flash={@flash} />
<main class="flex items-center justify-center w-full bg-base-100 h-full">
  <div class="w-full max-w-lg h-fit my-auto">
    <div class="px-4 py-8 border-b border-base-300">
      <h1 class="text-base-content text-3xl font-black tracking-widest uppercase">
        Wheel Flat Reports
      </h1>
      <p class="mt-2 text-base-content/60 text-sm font-bold tracking-wider uppercase">
        Heard a thumping noise on your commute?
      </p>
      <.link
        href={~p"/reports/new"}
        class="mt-4 btn btn-primary font-black tracking-widest uppercase w-full"
      >
        + Report a Wheel Flat
      </.link>
    </div>

    <div class="px-4 pt-4 pb-1">
      <p class="text-xs font-black tracking-widest uppercase text-base-content/40">
        Severity score by line
      </p>
    </div>
    <div class="divide-y divide-base-300">
      <%= for {line, count} <- Enum.sort(@stats) do %>
        <div class="flex items-center justify-between px-4 py-5">
          <div class="flex items-center gap-4">
            <span
              class="w-5 h-5 rounded-full flex-shrink-0"
              style={"background-color: " <> Map.get(%{red: "#DA291C", orange: "#ED8B00", green: "#00843D", blue: "#003DA5"}, line, "#71717a")}
            >
            </span>
            <span class="text-base-content text-xl font-bold tracking-wide uppercase">
              {line} Line
            </span>
          </div>
          <span class="text-base-content text-2xl font-black tabular-nums">{count}</span>
        </div>
      <% end %>
    </div>
  </div>
</main>
